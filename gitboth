#!/usr/bin/env bash
# gitboth — commit lalu push ke setiap remote yang unik (GitHub + GitLab, dst).
set -euo pipefail

PROG=${0##*/}
STAGE_ALL=1
DRY_RUN=0
CHECK=0
MESSAGE=""
REMOTE_PATTERNS=()

usage() {
	cat <<EOF
Pemakaian: $PROG [-m] "pesan commit" [opsi]

Commit perubahan lalu push branch aktif ke setiap remote unik.
Remote yang menunjuk URL push yang sama hanya dipush sekali.

Opsi:
  -m, --message <teks>  pesan commit (boleh juga sebagai argumen posisional)
  -s, --staged          hanya commit yang sudah di-stage (tanpa 'git add -A')
  -r, --remote <pola>   hanya push remote yang namanya cocok (boleh diulang)
  -c, --check           setelah push, pastikan ref remote sama dengan commit lokal
  -n, --dry-run         tampilkan rencana, tanpa mengubah index/commit/push
  -h, --help            tampilkan bantuan ini

Kalau satu remote gagal, remote lain tetap dipush dan exit code jadi 1.
EOF
}

die() {
	printf '%s: %s\n' "$PROG" "$1" >&2
	exit 1
}

while [ $# -gt 0 ]; do
	case $1 in
	-m | --message)
		[ $# -ge 2 ] || die "opsi $1 butuh argumen"
		MESSAGE=$2
		shift 2
		;;
	-m?*)
		MESSAGE=${1#-m}
		shift
		;;
	-s | --staged) STAGE_ALL=0; shift ;;
	-r | --remote)
		[ $# -ge 2 ] || die "opsi $1 butuh argumen"
		REMOTE_PATTERNS+=("$2")
		shift 2
		;;
	-c | --check) CHECK=1; shift ;;
	-n | --dry-run) DRY_RUN=1; shift ;;
	-h | --help) usage; exit 0 ;;
	--)
		shift
		[ $# -gt 0 ] || die "pesan commit kosong"
		MESSAGE=$1
		shift
		;;
	-*) die "opsi tidak dikenal: $1 (lihat --help)" ;;
	*)
		[ -z "$MESSAGE" ] || die "pesan commit ganda: '$MESSAGE' dan '$1'"
		MESSAGE=$1
		shift
		;;
	esac
done

git rev-parse --git-dir >/dev/null 2>&1 || die "bukan repository git"

BRANCH=$(git symbolic-ref --short -q HEAD) ||
	die "HEAD detached; checkout branch dulu"

# Kumpulkan URL push unik lintas remote; label = nama remote pertama yang memakainya.
host_of() {
	local u=${1#*://}
	case $u in *@*) u=${u##*@} ;; esac
	u=${u%%/*}
	u=${u%%:*}
	printf '%s' "${u:-lokal}"
}

URLS=()
LABELS=()
SEEN=$'\n'
matches_filter() {
	[ ${#REMOTE_PATTERNS[@]} -eq 0 ] && return 0
	local pat
	for pat in "${REMOTE_PATTERNS[@]}"; do
		# shellcheck disable=SC2053
		[[ $1 == $pat ]] && return 0
	done
	return 1
}
while IFS= read -r remote; do
	matches_filter "$remote" || continue
	while IFS= read -r url; do
		[ -n "$url" ] || continue
		case $SEEN in
		*$'\n'"$url"$'\n'*) continue ;;
		esac
		SEEN+="$url"$'\n'
		URLS+=("$url")
		LABELS+=("$remote ($(host_of "$url"))")
	done < <(git remote get-url --push --all "$remote")
done < <(git remote)

if [ ${#URLS[@]} -eq 0 ]; then
	if [ ${#REMOTE_PATTERNS[@]} -gt 0 ]; then
		die "tidak ada remote yang cocok dengan: ${REMOTE_PATTERNS[*]}"
	fi
	die "tidak ada remote terpasang"
fi

if [ "$DRY_RUN" -eq 1 ]; then
	printf '[dry-run] branch: %s, remote: %s\n' "$BRANCH" "${LABELS[*]}"
	printf '[dry-run] perubahan:\n'
	git status --short
	if [ -n "$MESSAGE" ]; then
		printf '[dry-run] commit: %s\n' "$MESSAGE"
	else
		printf '[dry-run] commit: (pesan belum diberikan)\n'
	fi
	for label in "${LABELS[@]}"; do
		printf '[dry-run] push: %s %s\n' "$label" "$BRANCH"
	done
	[ "$CHECK" -eq 0 ] || printf '[dry-run] check: ref remote dibandingkan dengan commit lokal\n'
	exit 0
fi

if [ -n "$(git status --porcelain)" ] && [ -z "$MESSAGE" ]; then
	die "ada perubahan tapi pesan commit kosong; pakai: $PROG \"pesan\""
fi

for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
	if [ -e "$(git rev-parse --git-path "$marker")" ]; then
		die "repo sedang dalam proses ${marker%_HEAD}; selesaikan atau batalkan dulu"
	fi
done
for dir in rebase-merge rebase-apply; do
	if [ -d "$(git rev-parse --git-path "$dir")" ]; then
		die "repo sedang rebase; selesaikan atau batalkan dulu"
	fi
done

if [ "$STAGE_ALL" -eq 1 ]; then
	git add -A
fi

if git diff --cached --quiet; then
	printf '%s: tidak ada perubahan untuk di-commit, lanjut push\n' "$PROG"
else
	git commit -q -m "$MESSAGE"
	printf '%s: commit dibuat: %s\n' "$PROG" "$(git log -1 --format='%h %s')"
fi

FAILED=()
ERRLOG=$(mktemp)
trap 'rm -f "$ERRLOG"' EXIT
LOCAL_SHA=$(git rev-parse "refs/heads/$BRANCH")
for i in "${!URLS[@]}"; do
	printf '%s: push %s -> %s\n' "$PROG" "$BRANCH" "${LABELS[$i]}"
	if ! git push --quiet "${URLS[$i]}" "refs/heads/$BRANCH:refs/heads/$BRANCH" 2>"$ERRLOG"; then
		FAILED+=("${LABELS[$i]}")
		sed 's/^/    /' "$ERRLOG" >&2
		continue
	fi
	[ "$CHECK" -eq 1 ] || continue
	REMOTE_SHA=$(git ls-remote "${URLS[$i]}" "refs/heads/$BRANCH" 2>/dev/null | awk '{print $1; exit}')
	if [ "$REMOTE_SHA" = "$LOCAL_SHA" ]; then
		printf '%s: ok %s %s\n' "$PROG" "${LABELS[$i]}" "${LOCAL_SHA:0:7}"
	else
		FAILED+=("${LABELS[$i]} (ref remote ${REMOTE_SHA:0:7} != lokal ${LOCAL_SHA:0:7})")
	fi
done

if [ ${#FAILED[@]} -gt 0 ]; then
	printf '%s: %d dari %d remote gagal: %s\n' \
		"$PROG" "${#FAILED[@]}" "${#URLS[@]}" "${FAILED[*]}" >&2
	exit 1
fi

printf '%s: selesai (%d remote)\n' "$PROG" "${#URLS[@]}"
